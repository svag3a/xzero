# Anthropic API (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Tavily (web search in opportunity scan)
TAVILY_API_KEY=tvly-...

# App authentication
APP_PASSWORD=your-password-here
APP_SECRET_KEY=random-secret-string-here

# SCB import token (used by scb_sync.py to push company data)
SCB_IMPORT_TOKEN=generate-with-python3-secrets-token-hex-24

# Public URL of the app (used in notification emails)
APP_BASE_URL=https://your-domain.se

# Email notifications (optional — skip to disable)
NOTIFY_EMAIL=team@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=smtp-password
SMTP_FROM=noreply@example.com

# Fireflies (meeting transcripts — optional)
FIREFLIES_API_KEY=

# Data directory (default: current dir; Docker: /data)
DATA_DIR=/data
